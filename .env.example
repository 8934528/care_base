# CareBase - Configuration Template



# Copy this file to '.env' in the project root:
#   cp .env.example .env



# Update the values below with your PostgreSQL / pgAdmin database credentials


# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carebase
DB_USER=postgres
DB_PASSWORD=your_pgadmin_password_here

# alt, specify a full connection string:
# DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=carebase;Username=postgres;Password=your_pgadmin_password_here

# JWT Authentication Configuration

JWT_SECRET=CareBase_Production_Secure_Key_2026_Healthcare_System_Enterprise!
JWT_ISSUER=CareBaseAPI
JWT_AUDIENCE=CareBaseClient
JWT_EXPIRY_HOURS=8

# Facility & Operational Configuration
FACILITY_NAME="CareBase Regional Healthcare Center"
FACILITY_CODE="CB-HQ-01"

# Frontend Configuration
VITE_API_URL=http://localhost:5076/api
